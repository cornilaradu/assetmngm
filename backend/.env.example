# Baza de date PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_maintenance?schema=public"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_SECRET="schimba-acest-secret-cu-unul-lung-si-random"
JWT_EXPIRES_IN="8h"

# SMTP pentru trimiterea remindere-lor pe email
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="mentenanta@compania.ro"
SMTP_PASS="parola-sau-app-password"
EMAIL_FROM="Portal Mentenanta <mentenanta@compania.ro>"

# La ce ora ruleaza zilnic verificarea de remindere (cron), format cron standard
# Implicit: in fiecare zi la 07:00
REMINDER_CRON_SCHEDULE="0 7 * * *"

# Cate zile inainte de scadenta consideram mentenanta "DUE_SOON" daca schedule-ul
# nu are propria valoare reminderDaysBefore (fallback)
DEFAULT_REMINDER_DAYS_BEFORE=7

# Folder unde se salveaza documentele de mentenanta atasate (certificate, rapoarte etc.)
# IMPORTANT: pune o cale ABSOLUTA in afara folderului proiectului (nu in /opt/asset-maintenance-portal),
# ca fisierele sa NU fie sterse la un "git clone" curat / re-deploy.
UPLOAD_DIR="/var/lib/asset-maintenance/uploads"

# Dimensiune maxima per fisier atasat, in MB
MAX_FILE_SIZE_MB=15
